# Copy this file to .env.local for local development, and add these
# same variables in your Vercel Project Settings -> Environment Variables.

# Required: any long random string, used to sign admin login sessions.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: admin login username (defaults to "admin" if not set)
ADMIN_USERNAME=admin

# Optional: initial admin password used only the very first time the site
# runs (before anyone has changed it from the dashboard). Defaults to
# Aapulki@2026 if not set. Change your password from the admin dashboard.
ADMIN_DEFAULT_PASSWORD=Aapulki@2026

# Cloudinary Configuration (100% Free - No Credit Card Needed, No Presets Needed!)
# Found on your Cloudinary Dashboard: https://console.cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

