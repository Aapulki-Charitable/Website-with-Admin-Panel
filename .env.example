# Copy this file to .env.local for local development, and also add these
# same variables in Vercel: Project -> Settings -> Environment Variables.

# Required: any long random string, used to sign admin login sessions.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: admin login username (defaults to "admin" if not set)
ADMIN_USERNAME=admin

# Optional: initial admin password used only the very first time the site
# runs (before anyone has changed it from the dashboard). Defaults to
# Aapulki@2026 if not set. Change your password from the admin dashboard
# after first login — after that, this variable is no longer used.
ADMIN_DEFAULT_PASSWORD=Aapulki@2026

# Provided automatically by Vercel once you connect a Blob store to this
# project (Project -> Storage -> Create Database -> Blob). You do not need
# to set this by hand on Vercel; it's only needed here for local dev if you
# want to test against your real Blob store.
BLOB_READ_WRITE_TOKEN=
